    {
        "id": "c8e146f55a47fb4e",
        "type": "function",
        "name": "跨越門檻告警",
        "func": "// 跨越門檻才告警：用 context 記住「現在是不是超標」，再加 0.5 度緩衝\nconst TH = flow.get(\"th\") || 30;      // 門檻：儀表板上可以調，預設 30 度\nconst BAND = 0.5;\nconst t = msg.payload;\nlet hot = context.get(\"hot\") || false;\nif (!hot && t > TH) {                 // 從沒超標變成超標：只送這一次\n    context.set(\"hot\", true);\n    return { topic: \"告警\", payload: \"溫度過高：\" + t + \" °C（門檻 \" + TH + \"）\" };\n}\nif (hot && t < TH - BAND) {           // 降到門檻減 0.5 以下才算解除\n    context.set(\"hot\", false);\n    return { topic: \"解除\", payload: \"溫度恢復：\" + t + \" °C\" };\n}\nreturn null;                          // 狀態沒變：不送，通知不會一直跳",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
