    {
        "id": "b56a25c3fb27c872",
        "type": "function",
        "name": "資料新鮮度",
        "func": "// 每秒檢查一次：最後一筆收到多久了？（沒資料進來也要檢查，所以用 inject 每秒觸發）\nconst STALE = 15;                     // 每 5 秒一筆，連續 3 筆沒來＝過期\nconst last = flow.get(\"lastA\");\nif (last === undefined) {\n    return { payload: \"還沒收到 A 的資料\", color: \"#9AA4B2\" };\n}\nconst age = Math.round((Date.now() - last) / 1000);\nif (age > STALE) {\n    return { payload: \"資料已過期：\" + age + \" 秒沒更新\", color: \"#E5484D\" };\n}\nreturn { payload: age + \" 秒前更新\", color: \"#2EAD6B\" };",
