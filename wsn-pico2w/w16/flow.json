    {
        "id": "6369e334347ea754",
        "type": "function",
        "name": "拆欄位",
        "func": "// 拆欄位：A 板送來的一筆 JSON → 六個輸出（圖表、量表、文字）\nlet d = msg.payload;\nif (typeof d === \"string\") { d = JSON.parse(d); }   // 前面沒轉成物件也不會壞\nconst num = v => typeof v === \"number\" && isFinite(v);\n// 檢查一：溫度和 seq 一定要有，而且 -20 ≤ t < 85（85 常是感測器出錯的值）\nif (!num(d.t) || !num(d.seq) || d.t < -20 || d.t >= 85) {\n    context.set(\"bad\", (context.get(\"bad\") || 0) + 1);\n    node.warn(\"丟掉一筆：\" + JSON.stringify(d));\n    return null;\n}\n// 檢查二：用 seq 算遺失率；seq 變小代表 A 重開機，重新起算\nlet first = context.get(\"first\"), got = context.get(\"got\") || 0;\nif (first === undefined || d.seq < context.get(\"seq\")) { first = d.seq; got = 0; }\ngot += 1;\ncontext.set(\"first\", first); context.set(\"got\", got); context.set(\"seq\", d.seq);\nconst should = d.seq - first + 1;\nconst loss = (100 * (should - got) / should).toFixed(1);\n// 記下收到的時間（平台端蓋時間），給「資料新鮮度」用\nconst now = new Date();\nflow.set(\"lastA\", now.getTime());\n// 六個輸出：缺的欄位那一路送 null（不輸出），不要補 0\nconst out = (name, v) => num(v) ? { topic: name, payload: v } : null;\nreturn [\n    [out(\"AHT20\", d.t), out(\"BMP280\", d.t2)],   // 1 溫度折線：兩條線\n    out(\"溫度\", d.t),                            // 2 溫度量表＋告警\n    out(\"濕度\", d.h),                            // 3 濕度量表\n    out(\"氣壓\", d.p),                            // 4 氣壓折線（自己一張）\n    out(\"照度\", d.lux),                          // 5 照度折線（自己一張）\n    { payload: d.id + \" #\" + d.seq + \"｜\" + now.toTimeString().slice(0, 8)\n               + \" 收到｜遺失 \" + loss + \"%\" }    // 6 最後更新\n];",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
